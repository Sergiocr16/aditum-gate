{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Aditum Gate device configuration",
  "type": "object",
  "required": ["schemaVersion", "configRevision", "api", "scannerType", "scanners", "screen", "gpio"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "configRevision": { "type": "integer", "minimum": 0 },
    "deviceId": { "type": "string" },
    "placeName": { "type": "string" },
    "api": {
      "type": "object",
      "required": ["baseUrl", "verifierStyle"],
      "additionalProperties": false,
      "properties": {
        "baseUrl": { "type": "string", "pattern": "^https?://" },
        "verifierStyle": { "enum": ["secure", "legacy"] }
      }
    },
    "scannerType": { "enum": ["hid", "opencv", "hikvision", "none"] },
    "scanners": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "doorId"],
        "additionalProperties": false,
        "properties": {
          "role": { "enum": ["entry", "exit"] },
          "doorId": { "type": "string" },
          "deviceName": { "type": "string", "description": "Nombre (o parte) del lector HID en /proc/bus/input/devices" },
          "devicePhys": { "type": "string", "description": "Puerto fisico USB del lector HID (parte del Phys= en /proc/bus/input/devices); fija que pistola es este lector cuando hay dos identicas" },
          "cameraIndex": { "type": "integer", "minimum": 0, "description": "Indice de /dev/video* para scanners OpenCV" },
          "showCameraFeed": { "type": "boolean", "default": false, "description": "Muestra el cuadro de la camara en tiempo real en la pantalla local (ventana por camara)" },
          "strictMarkerMatch": { "type": "boolean", "default": false, "description": "Deniega localmente (sin consultar al backend) si el marcador EXIT del QR no coincide con el rol del lector; semantica del scannerExit.py original" }
        }
      }
    },
    "screen": {
      "type": "object",
      "required": ["hasScreen"],
      "additionalProperties": false,
      "properties": {
        "hasScreen": { "type": "boolean" },
        "doorType": { "enum": ["ENTRY", "EXIT"] },
        "clientLogoUrl": { "type": "string" }
      }
    },
    "gpio": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["BOARD", "BCM"], "default": "BOARD" },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "pin"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "pin": { "type": "integer", "minimum": 1 },
              "normallyOpen": { "type": "boolean", "default": true }
            }
          }
        },
        "pulseSeconds": { "type": "number", "minimum": 0.1, "default": 1 },
        "neopixel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "pin": { "type": "string", "default": "D18" },
            "count": { "type": "integer", "default": 55 }
          }
        },
        "watchdog": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "host": { "type": "string", "default": "1.1.1.1" },
            "intervalSec": { "type": "integer", "minimum": 30, "default": 240 }
          }
        }
      }
    },
    "hikvision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "nightlyCleanupHour": { "type": "integer", "minimum": 0, "maximum": 23, "default": 2 }
      }
    },
    "anpr": {
      "type": "object",
      "additionalProperties": false,
      "description": "ANPR local-first (TAR-1034/1035): endpoints de placas hacia las camaras y cola offline de eventos",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "cameras": {
          "type": "array",
          "description": "Camaras ANPR del sitio. Doble funcion: allowlist de quien puede postear en /anpr-event, y a que porton pertenece cada lectura. Vacio = cualquier IP privada de la LAN y sin porton asignado",
          "items": {
            "type": "object",
            "required": ["ip"],
            "additionalProperties": false,
            "properties": {
              "ip": { "type": "string", "description": "IP de la camara en la LAN del condominio" },
              "gateId": { "type": "integer", "minimum": 1, "description": "Porton (gate.id de Aditum) al que pertenecen las lecturas de esta camara" },
              "name": { "type": "string", "description": "Etiqueta libre para identificarla en el editor" }
            }
          }
        },
        "purgeDays": { "type": "integer", "minimum": 0, "maximum": 90, "default": 7, "description": "Dias que se conservan las lecturas ya confirmadas por Aditum antes de borrarlas. 0 = borrarlas apenas Aditum confirma (la cola queda solo con lo pendiente)" }
      }
    },
    "polling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 10, "default": 60 },
        "enabled": { "type": "boolean", "default": false }
      }
    }
  }
}
